# Deployment configuration
# Copy this file to .deploy.env and fill in your values
#
# Usage:
#   cp .deploy.env.example .deploy.env
#   # Edit .deploy.env with your server details
#   make deploy

VM_HOST="user@your-server.example.com"
VM_PORT=22
REMOTE_DIR="/opt/your-app"
PRODUCTION_URL="https://your-domain.example.com"
